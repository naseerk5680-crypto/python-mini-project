# ============================================================
# Study with A.I. — Environment Variables
# 1. Copy this file and rename the copy to ".env"
# 2. Fill in your real API key(s) below
# 3. NEVER commit your real .env file to Git / GitHub
# ============================================================

# Which AI provider the backend should use: "gemini" or "openai"
AI_PROVIDER=gemini

# --- Google Gemini (get a free key at https://aistudio.google.com/app/apikey) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# --- OpenAI (only needed if AI_PROVIDER=openai) ---
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Flask settings ---
FLASK_DEBUG=True
